# DiffSeek / Linguist attributes for Acme Checkout

# Generated artifacts
web/src/generated/** linguist-generated
web/src/payments/generated/** linguist-generated
**/*.gen.proto linguist-generated
**/__snapshots__/** linguist-generated

# Groups: last matching line wins
*.ts group=App
*.tsx group=App
*.proto group=App
*.sql group=App
**/*.yaml group=Config
**/featureFlags.ts group=Config
CODEOWNERS group=Config
.gitattributes group=Config

# Tests
**/*.test.ts group=Tests
**/*.test.tsx group=Tests
**/__tests__/** group=Tests
**/__snapshots__/** group=Tests

# Languages
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
